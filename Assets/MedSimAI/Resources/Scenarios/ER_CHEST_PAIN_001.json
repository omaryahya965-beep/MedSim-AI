  "objectives": [
    {
      "id": "OBJ_INTRO",
      "text": "Introduce yourself professionally, confirm the patient's identity and obtain consent."
    },
    {
      "id": "OBJ_HISTORY",
      "text": "Obtain a focused chest pain history (onset, character, radiation, associated symptoms, severity)."
    },
    {
      "id": "OBJ_RISK",
      "text": "Identify cardiovascular risk factors, medications and allergies."
    },
    {
      "id": "OBJ_VITALS",
      "text": "Measure and interpret blood pressure, oxygen saturation and pulse."
    },
    {
      "id": "OBJ_EXAM",
      "text": "Auscultate the heart and lungs."
    },
    {
      "id": "OBJ_ECG",
      "text": "Obtain and review a 12-lead ECG early."
    },
    {
      "id": "OBJ_ESCALATE",
      "text": "Recognise the need for urgent senior escalation and communicate your reasoning."
    }
  ],
