  "instructorLines": {
    "welcome": "Welcome. I am Dr. Sara Hassan, and I will be supervising you today. Mr. Reyes, fifty-eight, has come in with chest pain. Assess him as you would a real patient, and tell me what you think. Open the door when you are ready.",
    "tutorial": "",
    "historyDone": "",
    "examDone": "",
    "ecgShown": "",
    "reasoningPrompt": "Please summarise your findings for me, and tell me what you think needs to happen next.",
    "escalationAck": "Thank you. That's an appropriate escalation. I'll support you while the team arrives.",
    "debriefIntro": "Let's review your session together.",
    "outOfScope": "That's outside what we can cover in this simulation. Please raise it with your clinical tutor.",
    "noHintAvailable": "You're doing well. Keep going with your assessment.",
    "onboardingRole": "",
    "onboardingInstruments": "",
    "welcomeBrief": "Welcome the student in the corridor outside the examination room. Introduce yourself as Dr. Sara Hassan, their supervising physician. Task: Mr. Adam Reyes, fifty-eight, has come in with chest pain; assess him as you would a real patient and tell me what you think and what you would do. Invite them to open the door when ready.",
    "roomEntry": "",
    "discussionIntro": "Let's step back for a moment. Talk me through your assessment."
  },
